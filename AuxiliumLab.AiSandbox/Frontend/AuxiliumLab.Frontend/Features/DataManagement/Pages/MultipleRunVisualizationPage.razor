@page "/data-management/visualization/multiple-run"
@using ApexCharts
@inject IStatisticsApiClient StatisticsApi

<PageHeader Title="Multiple Run Visualization" />

<MudGrid Class="mb-4">
    <MudItem xs="12" md="4">
        <MudSelect @bind-Value="SelectedJobId" Label="Select Simulation Run"
                   Variant="Variant.Outlined" T="Guid?" ToStringFunc="@(id => id.HasValue ? id.Value.ToString()[..8] + "…" : "— Select —")">
            <MudSelectItem T="Guid?" Value="null">— Select —</MudSelectItem>
            @foreach (var run in _runs)
            {
                var runId = (Guid?)run.JobId;
                <MudSelectItem T="Guid?" Value="runId">
                    @run.JobId.ToString()[..8]… | @run.Kind | @run.StartedAt.ToString("yyyy-MM-dd HH:mm")
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="2" Class="d-flex align-center">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync" Disabled="_loading">Refresh</MudButton>
    </MudItem>
</MudGrid>

@if (_selected is not null)
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Win vs Loss</MudText>
            <ApexChart TItem="PieItem" Title="">
                <ApexPointSeries TItem="PieItem"
                                 Items="_pieItems"
                                 Name="Count"
                                 SeriesType="SeriesType.Donut"
                                 XValue="@(e => e.Label)"
                                 YValue="@(e => (decimal)e.Value)" />
            </ApexChart>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">@_selected.Kind</MudText>
                    <MudDivider Class="my-2" />
                    <MudText>Total Runs: <strong>@_selected.TotalRuns</strong></MudText>
                    <MudText>Wins: <strong>@_selected.Wins</strong></MudText>
                    <MudText>Losses: <strong>@_selected.Losses</strong></MudText>
                    <MudText>Win Rate: <strong>@_selected.WinPercentage.ToString("F1")%</strong></MudText>
                    <MudText>Avg Turns: <strong>@_selected.AverageTurns.ToString("F1")</strong></MudText>
                    <MudText>Started: <strong>@_selected.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</strong></MudText>
                    <MudText>Completed: <strong>@_selected.CompletedAt.ToString("yyyy-MM-dd HH:mm:ss")</strong></MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
else if (!_loading && _runs.Count == 0)
{
    <MudAlert Severity="Severity.Info">No completed simulation runs found.</MudAlert>
}


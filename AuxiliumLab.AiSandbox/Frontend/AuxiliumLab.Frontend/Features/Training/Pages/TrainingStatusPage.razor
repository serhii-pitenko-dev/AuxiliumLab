@page "/training/status"
@inject ITrainingApiClient TrainingApi
@inject INotificationService Notifications
@implements IDisposable

<PageHeader Title="Training Status" />

<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
           OnClick="RefreshAsync" Disabled="_loading" Class="mb-4">
    Refresh
</MudButton>

@if (!_jobs.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4">No training jobs found.</MudAlert>
}
else
{
    @foreach (var job in _jobs)
    {
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center gap-3">
                        <MudChip T="string" Color="@StateColor(job.State)" Size="Size.Small">@job.State</MudChip>
                        <MudText Typo="Typo.h6">@job.Algorithm</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">@job.ExperimentId</MudText>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    @if (job.State == TrainingJobState.Running)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error"
                                       aria-label="Stop" OnClick="@(() => StopAsync(job.JobId))" />
                    }
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @if (job.State == TrainingJobState.Running && job.TotalTimesteps > 0)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.body2">
                                <b>@job.TimestepsDone.ToString("N0")</b> / @job.TotalTimesteps.ToString("N0") timesteps
                            </MudText>
                            <MudText Typo="Typo.body2">@ProgressPercent(job).ToString("F1")%</MudText>
                        </div>
                        <MudProgressLinear Value="@ProgressPercent(job)" Color="Color.Primary"
                                           Rounded="true" Size="Size.Medium" />
                    </div>
                }

                <MudSimpleTable Dense="true" Bordered="true">
                    <tbody>
                        <tr>
                            <td><b>Job ID</b></td>
                            <td style="font-family:monospace;font-size:0.85rem">@job.JobId.ToString()[..8]…</td>
                        </tr>
                        <tr>
                            <td><b>Started</b></td>
                            <td>@job.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                        @if (job.CompletedAt.HasValue)
                        {
                            <tr>
                                <td><b>Completed</b></td>
                                <td>@job.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                        <tr>
                            <td><b>Elapsed</b></td>
                            <td>@FormatElapsed(job)</td>
                        </tr>
                        @if (job.State == TrainingJobState.Running && job.TimestepsDone > 0 && job.TotalTimesteps > 0)
                        {
                            <tr>
                                <td><b>ETA</b></td>
                                <td>@FormatEta(job)</td>
                            </tr>
                        }
                        @if (job.NumEnvironments > 0)
                        {
                            <tr>
                                <td><b>Parallel Environments</b></td>
                                <td>@job.NumEnvironments</td>
                            </tr>
                        }
                        @if (job.State == TrainingJobState.Failed && !string.IsNullOrEmpty(job.ErrorMessage))
                        {
                            <tr>
                                <td><b>Error</b></td>
                                <td style="color:var(--mud-palette-error);word-break:break-all">@job.ErrorMessage</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    }
}

@if (_failedModels.Any())
{
    <MudText Typo="Typo.h5" Class="mt-6 mb-3">Failed Trainings (History)</MudText>
    @foreach (var model in _failedModels)
    {
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center gap-3">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                 aria-label="Failed Training Badge">Failed</MudChip>
                        <MudText Typo="Typo.h6">@model.Algorithm</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">@model.ExperimentId</MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable Dense="true" Bordered="true">
                    <tbody>
                        <tr>
                            <td><b>Date</b></td>
                            <td>@model.TrainedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                        @if (model.Preconditions is not null)
                        {
                            <tr>
                                <td><b>Parallel Environments</b></td>
                                <td>@(model.Preconditions.Hyperparameters.GetValueOrDefault("n_envs", "—"))</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(model.ErrorMessage))
                        {
                            <tr>
                                <td><b>Error</b></td>
                                <td style="color:var(--mud-palette-error);word-break:break-all">@model.ErrorMessage</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    }
}


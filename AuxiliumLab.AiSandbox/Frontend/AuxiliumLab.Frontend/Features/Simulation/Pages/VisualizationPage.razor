@page "/simulation/visualization"
@using AuxiliumLab.AiSandbox.SharedBaseTypes.ValueObjects
@inject ISimulationApiClient SimulationApi
@inject ITrainingApiClient TrainingApi
@inject ISimulationHubClient HubClient
@inject INotificationService Notifications
@inject IOptions<SandboxSettings> SandboxConfig

<PageHeader Title="Simulation Visualization" />

<MudGrid>
    <!-- Left: config panel -->
    <MudItem xs="12" md="3">
        <MudCard Class="mb-3">
            <MudCardContent>
                <MudSelect Value="_cmd.Kind" ValueChanged="@((SimulationKind v) => OnKindChanged(v))" Label="Kind" Variant="Variant.Outlined" Class="mb-2">
                    <MudSelectItem Value="SimulationKind.RandomAI">Random AI</MudSelectItem>
                    <MudSelectItem Value="SimulationKind.TrainedAI">Trained AI</MudSelectItem>
                </MudSelect>

                @if (_cmd.Kind == SimulationKind.TrainedAI)
                {
                    <MudSelect Value="_cmd.Algorithm" ValueChanged="@((ModelType v) => OnAlgorithmChanged(v))" Label="Algorithm" Variant="Variant.Outlined" Class="mb-2">
                        <MudSelectItem Value="ModelType.PPO">PPO</MudSelectItem>
                        <MudSelectItem Value="ModelType.A2C">A2C</MudSelectItem>
                        <MudSelectItem Value="ModelType.DQN">DQN</MudSelectItem>
                    </MudSelect>

                    @if (_loadingModels)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="my-2" />
                    }
                    else if (_filteredModels.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">No trained models found for @_cmd.Algorithm.</MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Trained Models</MudText>
                        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Class="mb-2" Style="font-size:0.8rem">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Experiment</th>
                                    <th>Trained At</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var model in _filteredModels)
                                {
                                    var isSelected = _selectedModel?.ExperimentId == model.ExperimentId;
                                    <tr @onclick="() => OnModelSelected(model)" style="cursor:pointer;@(isSelected ? "background:#e3f2fd" : "")">
                                        <td><MudRadio Value="true" Checked="isSelected" Color="Color.Primary" Dense="true" /></td>
                                        <td>@model.ExperimentId</td>
                                        <td>@model.TrainedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @if (_selectedModel?.Preconditions is not null)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Training Preconditions</MudText>
                        <MudSimpleTable Dense="true" Bordered="true" Style="font-size:0.8rem" Class="mb-2">
                            <tbody>
                                <tr><td>Map</td><td>@_selectedModel.Preconditions.MapWidth x @_selectedModel.Preconditions.MapHeight</td></tr>
                                <tr><td>Max Turns</td><td>@_selectedModel.Preconditions.MaxTurns</td></tr>
                                <tr><td>Step Penalty</td><td>@_selectedModel.Preconditions.StepPenalty</td></tr>
                                <tr><td>Win Reward</td><td>@_selectedModel.Preconditions.WinReward</td></tr>
                                <tr><td>Loss Reward</td><td>@_selectedModel.Preconditions.LossReward</td></tr>
                                @foreach (var hp in _selectedModel.Preconditions.Hyperparameters)
                                {
                                    <tr><td>@hp.Key</td><td>@hp.Value</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }

                <SandboxSettingsForm Override="_override" OverrideChanged="OnOverrideChanged" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync"
                           Disabled="_running || _starting || (_cmd.Kind == SimulationKind.TrainedAI && _selectedModel is null)">
                    @if (_starting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                    Start
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="PauseResumeAsync" Disabled="!_running">
                    @(_paused ? "Resume" : "Pause")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="StopAsync" Disabled="!_running">
                    Stop
                </MudButton>
            </MudCardActions>
        </MudCard>

        <!-- Turn info -->
        @if (_currentTurn > 0)
        {
            <MudText Typo="Typo.caption">Turn: @_currentTurn / @_maxTurns</MudText>
            <MudProgressLinear Value="@((double)_currentTurn / (_maxTurns > 0 ? _maxTurns : 1) * 100)"
                               Color="Color.Primary" Class="mb-2" />
        }

        <!-- Agent list -->
        @if (_agents.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Agents</MudText>
            @foreach (var (id, a) in _agents)
            {
                <MudText Typo="Typo.caption">@a.Type #@id[..Math.Min(6, id.Length)]: spd=@a.Speed stm=@a.Stamina/@a.MaxStamina</MudText>
                <MudText Typo="Typo.caption" Style="margin-left:12px;color:#757575">
                    Run: @(a.IsRun ? "Active" : "Inactive")
                </MudText>
            }
        }
    </MudItem>

    <!-- Middle: grid -->
    <MudItem xs="12" md="6">
        @if (_gridWidth > 0 && _gridHeight > 0)
        {
            <div style="overflow:auto">
                <svg width="@(AxisMargin + _gridWidth * CellSize)" height="@(_gridHeight * CellSize + AxisMargin)"
                     style="display:block;border:1px solid #ccc">
                    @* Axis labels – X (bottom), capped at 99 *@
                    @for (var i = 0; i < _gridWidth && i < 100; i++)
                    {
                        @((MarkupString)$"<text x=\"{AxisMargin + i * CellSize + CellSize / 2}\" y=\"{_gridHeight * CellSize + AxisMargin - 4}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#616161\">{i}</text>")
                    }
                    @* Axis labels – Y (left), bottom-to-top, capped at 99 *@
                    @for (var i = 0; i < _gridHeight; i++)
                    {
                        var yLabel = _gridHeight - 1 - i;
                        if (yLabel < 100)
                        {
                            @((MarkupString)$"<text x=\"{AxisMargin - 3}\" y=\"{i * CellSize + CellSize / 2 + 4}\" text-anchor=\"end\" font-size=\"10\" fill=\"#616161\">{yLabel}</text>")
                        }
                    }
                    <g transform="translate(@(AxisMargin), 0)">
                        @* Layer 1 – base cells (blocks, exits, empty background) *@
                        @foreach (var cell in _cells.Values)
                        {
                            <rect x="@(cell.Position.X * CellSize)" y="@(cell.Position.Y * CellSize)"
                                  width="@CellSize" height="@CellSize"
                                  fill="@CellFill(cell.ObjectType)" stroke="#e0e0e0" stroke-width="0.5" />
                        }
                        @* Layer 2 – effect overlays (path / sight) on non-block cells *@
                        @foreach (var cell in _cells.Values)
                        {
                            var effectFill = GetEffectFill(cell);
                            if (effectFill is not null)
                            {
                                <rect x="@(cell.Position.X * CellSize)" y="@(cell.Position.Y * CellSize)"
                                      width="@CellSize" height="@CellSize"
                                      class="@GetEffectClass(cell)"
                                      fill="@effectFill" />
                            }
                        }
                        @* Layer 3 – agent circles (always on top) *@
                        @foreach (var (_, agent) in _agentPositions)
                        {
                            <circle cx="@(agent.Position.X * CellSize + CellSize / 2)"
                                    cy="@(agent.Position.Y * CellSize + CellSize / 2)"
                                    r="@(CellSize / 2 - 2)"
                                    fill="@AgentFill(agent.Type)" opacity="0.85" />
                        }
                    </g>
                </svg>
            </div>
            @* Legend *@
            <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:6px;font-size:0.72rem;align-items:center">
                <span style="display:flex;align-items:center;gap:4px">
                    <svg width="12" height="12"><rect width="12" height="12" fill="rgba(30,136,229,0.60)"/></svg> Hero path
                </span>
                <span style="display:flex;align-items:center;gap:4px">
                    <svg width="12" height="12"><rect width="12" height="12" fill="rgba(229,57,53,0.60)"/></svg> Enemy path
                </span>
                <span style="display:flex;align-items:center;gap:4px">
                    <svg width="12" height="12"><rect width="12" height="12" fill="rgba(30,136,229,0.20)"/></svg> Hero sight
                </span>
                <span style="display:flex;align-items:center;gap:4px">
                    <svg width="12" height="12"><rect width="12" height="12" fill="rgba(229,57,53,0.20)"/></svg> Enemy sight
                </span>
            </div>
        }
        else
        {
            <MudText Color="Color.Secondary">Start a simulation to see the grid.</MudText>
        }

        @if (_outcome is not null)
        {
            <MudAlert Severity="@(_outcome == "Won" ? Severity.Success : Severity.Error)" Class="mt-2">
                Simulation ended: @_outcome @(_reason is not null ? $"({_reason})" : "")
            </MudAlert>
        }
    </MudItem>

    <!-- Right: event log -->
    <MudItem xs="12" md="3">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Event Log</MudText>
        <div style="height:520px;overflow-y:auto;font-size:0.75rem;font-family:monospace;background:#f5f5f5;padding:8px;border-radius:4px">
            @foreach (var log in _logs)
            {
                <div>@log</div>
            }
        </div>
    </MudItem>
</MudGrid>


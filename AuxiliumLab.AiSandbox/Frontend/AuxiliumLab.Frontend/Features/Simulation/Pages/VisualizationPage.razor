@page "/simulation/visualization"
@using AuxiliumLab.AiSandbox.SharedBaseTypes.ValueObjects
@inject ISimulationApiClient SimulationApi
@inject ITrainingApiClient TrainingApi
@inject ISimulationHubClient HubClient
@inject INotificationService Notifications
@inject IOptions<SandboxSettings> SandboxConfig

<PageHeader Title="Simulation Visualization" />

@if (!_simulationActive)
{
    @* ═══ Configuration Phase ═══ *@
    <MudGrid>
        @* Left: Per-agent AI selection *@
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Agent AI Configuration</MudText>
            @if (_loadingModels)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-2" />
            }

            @* Hero AI selector *@
            <MudCard Outlined="true" Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">Hero AI</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudDataGrid T="SimulationSourceRow" Items="_rows" Dense="true" Hover="true"
                                 SelectedItem="_selectedHeroRow" SelectedItemChanged="OnHeroRowSelected"
                                 SelectOnRowClick="true" Filterable="false" SortMode="SortMode.None"
                                 Groupable="true" aria-label="Hero AI Selection">
                        <Columns>
                            <PropertyColumn Property="x => x.Group" Title="AI Type" Groupable="true" Grouping="true" Hidden="true" GroupExpanded="true">
                                <GroupTemplate>
                                    <span style="font-weight:bold">@context.Grouping.Key (@context.Grouping.Count())</span>
                                </GroupTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.Name" Title="Name" />
                            <PropertyColumn Property="x => x.AgentType" Title="Agent" />
                            <PropertyColumn Property="x => x.CreatedDate" Title="Created" Format="yyyy-MM-dd HH:mm" />
                        </Columns>
                    </MudDataGrid>
                </MudCardContent>
            </MudCard>

            @* Enemy AI selector *@
            <MudCard Outlined="true" Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Error">Enemy AI</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudDataGrid T="SimulationSourceRow" Items="_rows" Dense="true" Hover="true"
                                 SelectedItem="_selectedEnemyRow" SelectedItemChanged="OnEnemyRowSelected"
                                 SelectOnRowClick="true" Filterable="false" SortMode="SortMode.None"
                                 Groupable="true" aria-label="Enemy AI Selection">
                        <Columns>
                            <PropertyColumn Property="x => x.Group" Title="AI Type" Groupable="true" Grouping="true" Hidden="true" GroupExpanded="true">
                                <GroupTemplate>
                                    <span style="font-weight:bold">@context.Grouping.Key (@context.Grouping.Count())</span>
                                </GroupTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.Name" Title="Name" />
                            <PropertyColumn Property="x => x.AgentType" Title="Agent" />
                            <PropertyColumn Property="x => x.CreatedDate" Title="Created" Format="yyyy-MM-dd HH:mm" />
                        </Columns>
                    </MudDataGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Right: Start button + Preconditions + Sandbox Settings *@
        <MudItem xs="12" md="6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync"
                       FullWidth="true" Class="mb-3" Size="Size.Large"
                       Disabled="_starting"
                       StartIcon="@Icons.Material.Filled.PlayArrow">
                @if (_starting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Start Simulation
            </MudButton>

            @* Training Preconditions from selected trained models *@
            @{ var precondRow = _selectedHeroRow?.Preconditions is not null ? _selectedHeroRow : _selectedEnemyRow; }
            @if (precondRow?.Preconditions is not null)
            {
                <MudCard Outlined="true" Class="mb-3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1">Training Preconditions (@precondRow.Name)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSimpleTable Dense="true" Bordered="true" Style="font-size:0.85rem">
                            <tbody>
                                <tr><td><strong>Algorithm</strong></td><td>@precondRow.Preconditions.Algorithm</td></tr>
                                <tr><td><strong>Experiment</strong></td><td>@precondRow.Preconditions.ExperimentId</td></tr>
                                <tr><td><strong>Trainee Agent</strong></td><td>@precondRow.Preconditions.TraineeAgent</td></tr>
                                <tr><td><strong>Opponent AI</strong></td><td>@precondRow.Preconditions.OpponentAiType @(precondRow.Preconditions.OpponentModelId is not null ? $"({precondRow.Preconditions.OpponentModelId})" : "")</td></tr>
                                <tr><td><strong>Map</strong></td><td>@precondRow.Preconditions.MapWidth x @precondRow.Preconditions.MapHeight</td></tr>
                                <tr><td><strong>Max Turns</strong></td><td>@precondRow.Preconditions.MaxTurns</td></tr>
                                <tr><td><strong>Blocks %</strong></td><td>@precondRow.Preconditions.BlocksPercent</td></tr>
                                <tr><td><strong>Enemies %</strong></td><td>@precondRow.Preconditions.EnemiesPercent</td></tr>
                                <tr><td><strong>Hero</strong></td><td>Speed=@precondRow.Preconditions.HeroSpeed, Sight=@precondRow.Preconditions.HeroSightRange, Stamina=@precondRow.Preconditions.HeroStamina</td></tr>
                                <tr><td><strong>Enemy</strong></td><td>Speed=@precondRow.Preconditions.EnemySpeed, Sight=@precondRow.Preconditions.EnemySightRange, Stamina=@precondRow.Preconditions.EnemyStamina</td></tr>
                                <tr><td><strong>Step Penalty</strong></td><td>@precondRow.Preconditions.StepPenalty</td></tr>
                                <tr><td><strong>Win Reward</strong></td><td>@precondRow.Preconditions.WinReward</td></tr>
                                <tr><td><strong>Loss Reward</strong></td><td>@precondRow.Preconditions.LossReward</td></tr>
                                @foreach (var hp in precondRow.Preconditions.Hyperparameters)
                                {
                                    <tr><td><strong>@hp.Key</strong></td><td>@hp.Value</td></tr>
                                }
                                <tr><td><strong>Trained At</strong></td><td>@precondRow.Preconditions.StartedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            }
            else if (_selectedHeroRow?.Kind == SimulationKind.RandomAI && _selectedEnemyRow?.Kind == SimulationKind.RandomAI)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                    Both agents use Random AI — no training preconditions. Default sandbox settings are used.
                </MudAlert>
            }

            @* Sandbox Settings (editable) *@
            <SandboxSettingsForm Override="_override" OverrideChanged="OnOverrideChanged" DefaultExpanded="true" />
        </MudItem>
    </MudGrid>
}
else
{
    @* ═══ Simulation Phase ═══ *@

    @* Top control bar *@
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="BackToConfigAsync"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Back
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="PauseResumeAsync" Disabled="!_running">
            @(_paused ? "Resume" : "Pause")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="StopAsync" Disabled="!_running">
            Stop
        </MudButton>
        @if (_currentTurn > 0)
        {
            <MudText Typo="Typo.caption" Class="ml-2">Turn: @_currentTurn / @_maxTurns</MudText>
            <MudProgressLinear Value="@((double)_currentTurn / (_maxTurns > 0 ? _maxTurns : 1) * 100)"
                               Color="Color.Primary" Style="width:200px" />
        }
    </div>

    <MudGrid>
        @* Left: Agent list *@
        <MudItem xs="12" md="2">
            @if (_agents.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Agents</MudText>
                @foreach (var (id, a) in _agents)
                {
                    <MudText Typo="Typo.caption">@a.Type #@id[..Math.Min(6, id.Length)]: spd=@a.Speed stm=@a.Stamina/@a.MaxStamina</MudText>
                    <MudText Typo="Typo.caption" Style="margin-left:12px;color:#757575">
                        Run: @(a.IsRun ? "Active" : "Inactive")
                    </MudText>
                }
            }
        </MudItem>

        @* Middle: Grid *@
        <MudItem xs="12" md="7">
            @if (_gridWidth > 0 && _gridHeight > 0)
            {
                <div style="overflow:auto">
                    <svg width="@(AxisMargin + _gridWidth * CellSize)" height="@(_gridHeight * CellSize + AxisMargin)"
                         style="display:block;border:1px solid #ccc">
                        @* Axis labels – X (bottom), capped at 99 *@
                        @for (var i = 0; i < _gridWidth && i < 100; i++)
                        {
                            @((MarkupString)$"<text x=\"{AxisMargin + i * CellSize + CellSize / 2}\" y=\"{_gridHeight * CellSize + AxisMargin - 4}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#616161\">{i}</text>")
                        }
                        @* Axis labels – Y (left), bottom-to-top, capped at 99 *@
                        @for (var i = 0; i < _gridHeight; i++)
                        {
                            var yLabel = _gridHeight - 1 - i;
                            if (yLabel < 100)
                            {
                                @((MarkupString)$"<text x=\"{AxisMargin - 3}\" y=\"{i * CellSize + CellSize / 2 + 4}\" text-anchor=\"end\" font-size=\"10\" fill=\"#616161\">{yLabel}</text>")
                            }
                        }
                        <g transform="translate(@(AxisMargin), 0)">
                            @* Layer 1 – base cells (blocks, exits, empty background) *@
                            @foreach (var cell in _cells.Values)
                            {
                                <rect x="@(cell.Position.X * CellSize)" y="@(cell.Position.Y * CellSize)"
                                      width="@CellSize" height="@CellSize"
                                      fill="@CellFill(cell.ObjectType)" stroke="#e0e0e0" stroke-width="0.5" />
                            }
                            @* Layer 2 – effect overlays (path / sight) on non-block cells *@
                            @foreach (var cell in _cells.Values)
                            {
                                var effectFill = GetEffectFill(cell);
                                if (effectFill is not null)
                                {
                                    <rect x="@(cell.Position.X * CellSize)" y="@(cell.Position.Y * CellSize)"
                                          width="@CellSize" height="@CellSize"
                                          class="@GetEffectClass(cell)"
                                          fill="@effectFill" />
                                }
                            }
                            @* Layer 3 – agent circles (always on top) *@
                            @foreach (var (_, agent) in _agentPositions)
                            {
                                <circle cx="@(agent.Position.X * CellSize + CellSize / 2)"
                                        cy="@(agent.Position.Y * CellSize + CellSize / 2)"
                                        r="@(CellSize / 2 - 2)"
                                        fill="@AgentFill(agent.Type)" opacity="0.85" />
                            }
                        </g>
                    </svg>
                </div>
                @* Legend *@
                <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:6px;font-size:0.72rem;align-items:center">
                    <span style="display:flex;align-items:center;gap:4px">
                        <svg width="12" height="12"><rect width="12" height="12" fill="rgba(30,136,229,0.60)"/></svg> Hero path
                    </span>
                    <span style="display:flex;align-items:center;gap:4px">
                        <svg width="12" height="12"><rect width="12" height="12" fill="rgba(229,57,53,0.60)"/></svg> Enemy path
                    </span>
                    <span style="display:flex;align-items:center;gap:4px">
                        <svg width="12" height="12"><rect width="12" height="12" fill="rgba(30,136,229,0.20)"/></svg> Hero sight
                    </span>
                    <span style="display:flex;align-items:center;gap:4px">
                        <svg width="12" height="12"><rect width="12" height="12" fill="rgba(229,57,53,0.20)"/></svg> Enemy sight
                    </span>
                </div>
            }
            else
            {
                <div style="display:flex;align-items:center">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <MudText Color="Color.Secondary">Waiting for simulation data...</MudText>
                </div>
            }

            @if (_outcome is not null)
            {
                <MudAlert Severity="@(_outcome == "Won" ? Severity.Success : Severity.Error)" Class="mt-2">
                    Simulation ended: @_outcome @(_reason is not null ? $"({_reason})" : "")
                </MudAlert>
            }
        </MudItem>

        @* Right: Event log *@
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Event Log</MudText>
            <div style="height:520px;overflow-y:auto;font-size:0.75rem;font-family:monospace;background:#f5f5f5;padding:8px;border-radius:4px">
                @foreach (var log in _logs)
                {
                    <div>@log</div>
                }
            </div>
        </MudItem>
    </MudGrid>
}

<style>
    /* no grid-specific styles needed */
</style>

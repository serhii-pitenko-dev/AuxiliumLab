@page "/simulation/status"
@inject ISimulationApiClient SimulationApi
@inject INotificationService Notifications
@implements IDisposable

<PageHeader Title="Simulation Status" />

<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
           OnClick="RefreshAsync" Disabled="_loading" Class="mb-4">
    Refresh
</MudButton>

<MudTable Items="_jobs" Dense="true" Striped="true" Loading="_loading" LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>Job ID</MudTh>
        <MudTh>Kind</MudTh>
        <MudTh>State</MudTh>
        <MudTh>Runs</MudTh>
        <MudTh>Started At</MudTh>
        <MudTh>Completed At</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Job ID">
            <MudText Style="font-family:monospace;font-size:0.8rem">@context.JobId.ToString()[..8]…</MudText>
        </MudTd>
        <MudTd DataLabel="Kind">@context.Kind</MudTd>
        <MudTd DataLabel="State">
            <MudChip T="string" Color="@StateColor(context.State)" Size="Size.Small">@context.State</MudChip>
        </MudTd>
        <MudTd DataLabel="Runs">@context.CompletedRuns / @context.TotalRuns</MudTd>
        <MudTd DataLabel="Started At">@context.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="Completed At">@(context.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</MudTd>
        <MudTd DataLabel="Actions">
            @if (context.State == SimulationJobState.Running)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => StopAsync(context.JobId))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No simulation jobs found.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<SimulationJobStatusDto> _jobs = [];
    private bool _loading;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(_ => InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try { _jobs = await SimulationApi.GetSimulationStatusesAsync(); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task StopAsync(Guid jobId)
    {
        await SimulationApi.StopSimulationAsync(jobId);
        Notifications.Notify($"Stop requested for simulation job {jobId.ToString()[..8]}");
        await RefreshAsync();
    }

    private MudBlazor.Color StateColor(SimulationJobState state) => state switch
    {
        SimulationJobState.Running   => MudBlazor.Color.Info,
        SimulationJobState.Completed => MudBlazor.Color.Success,
        SimulationJobState.Failed    => MudBlazor.Color.Error,
        _                            => MudBlazor.Color.Default
    };

    public void Dispose() => _timer?.Dispose();
}

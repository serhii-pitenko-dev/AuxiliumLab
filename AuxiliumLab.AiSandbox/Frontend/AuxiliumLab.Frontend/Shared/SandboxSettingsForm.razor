@* Reusable form for SimulationSandboxOverrideDto / sandbox parameters.
   Bind via @bind-Value on the parent. *@

<MudCard Outlined="true" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">Sandbox Overrides <MudText Inline="true" Color="Color.Secondary">(optional)</MudText></MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="@(() => _expanded = !_expanded)" />
        </CardHeaderActions>
    </MudCardHeader>
    @if (_expanded)
    {
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="MaxTurns" Label="Max Turns" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="MapWidth" Label="Map Width" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="MapHeight" Label="Map Height" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="BlocksPercent" Label="Blocks %" Variant="Variant.Outlined" Step="0.01" Format="F2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="EnemiesPercent" Label="Enemies %" Variant="Variant.Outlined" Step="0.01" Format="F2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="HeroSpeed" Label="Hero Speed" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="HeroSightRange" Label="Hero Sight Range" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="HeroStamina" Label="Hero Stamina" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="EnemySpeed" Label="Enemy Speed" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
    }
</MudCard>

